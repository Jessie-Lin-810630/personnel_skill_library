FROM python:3.14.2-slim

WORKDIR /app

COPY requirements.txt .
RUN python -m pip install --no-cache-dir -U pip setuptools wheel && \
    python -m pip install --no-cache-dir -r requirements.txt

# Gold 服務本體與共用模組
COPY task07_common/ ./task07_common/
COPY task07_gold_service/ ./task07_gold_service/

# Cloud Run 以 $PORT 注入監聽埠（預設 8080）
EXPOSE 8080

# uvicorn 綁 $PORT；與 Silver 一致採單 worker。
CMD exec uvicorn task07_gold_service.app:app \
    --host 0.0.0.0 \
    --port ${PORT:-8080} \
    --workers 1
