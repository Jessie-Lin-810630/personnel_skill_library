FROM python:3.14.2-slim

WORKDIR /app

COPY requirements.txt .
RUN python -m pip install --no-cache-dir -U pip setuptools wheel && \
    python -m pip install --no-cache-dir -r requirements.txt

# Silver 服務本體與共用模組
COPY task07_common/ ./task07_common/
COPY task07_silver_service/ ./task07_silver_service/

# Cloud Run 以 $PORT 注入監聽埠（預設 8080）
EXPOSE 8080

# uvicorn 綁 $PORT；限單 worker 以維持斷路器 _guard 的 process 內狀態一致。
CMD exec uvicorn task07_silver_service.app:app \
    --host 0.0.0.0 \
    --port ${PORT:-8080} \
    --workers 1
