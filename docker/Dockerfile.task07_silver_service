FROM python:3.14.2-slim

WORKDIR /app

COPY requirements.txt .
RUN python -m pip install --no-cache-dir -U pip setuptools wheel && \
    python -m pip install --no-cache-dir -r requirements.txt

# Silver 服務本體與共用模組
COPY task07_common/ ./task07_common/
COPY task07_silver_service/ ./task07_silver_service/

# Cloud Run 以 $PORT 注入監聽埠（預設 8080）
EXPOSE 8080

# gunicorn 綁 $PORT；Silver 有 in-process 斷路器 _guard，故限單 worker 維持狀態一致，
# 以 threads 支援少量併發；--timeout 600 容納 LLM on-demand enrichment 的長耗時。
CMD exec gunicorn task07_silver_service.app:app \
    --bind 0.0.0.0:${PORT:-8080} \
    --workers 1 \
    --threads 8 \
    --timeout 600
