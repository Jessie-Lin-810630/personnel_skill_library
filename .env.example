# ─── Database ──────────────────────────────────────────────────────
# MongoDB local，地端測試用
MONGO_URI=mongodb://localhost:27017
#  MongoDB Altas: 地端測試ETL task06, task07 時就需要此雲端資料庫
MONGO_ALTAS_URI=<Connection-String-to-Altas>
# MongoDB local & MongoDB Altas 共用
MONGO_DB_NAME=<database-name-for-saving-obsidian-data>


# ─── Task01 ──────────────────────────────────────────────────────
# Obsidian Vault，下面是在地端測試才需要用，之後都直接連 GCS 的 vault (bucket):
OBSIDIAN_VAULT_PATH=<path>/<to>/<your-obsidian-vault>/


# ─── Task02 ──────────────────────────────────────────────────────
# GitHub REST API:
GITHUB_TOKEN=<ghp_xxxxxxxxxxxxxxxxxx-from-PAT>
GITHUB_USERNAME=<your-github-username>
GITHUB_MAIL=<your-github-register-mail>


# ─── Task03 ──────────────────────────────────────────────────────
# ccClub Judgement:
CCCLUB_USERNAME=<your-ccClub-username>
CCCLUB_PASSWORD=<your-ccClub-password>

# leetcode graphQL API:
LEETCODE_USERNAME=<your-leetcode-username>
LEETCODE_ACCOUNT=<your-leetcode-account>
LEETCODE_PASSWORD=<your-leetcode-password>
# 注意：只要瀏覽器有登出、以下兩個cookies就會失效
LEETCODE_SESSION=<session-from-your-browser-cookies>
CSRF_TOKEN=<csrf-from-your-browser-cookies>


# ─── Task05 ──────────────────────────────────────────────────────
# GOOGLE SHEET API:
# google sheet credential key file，只有在地端執行測試時需用到，雲端部署時改用 GOOGLE_SHEEY_KEY
GS_CREDENTIAL_FILE_PATH==<path>/<to>/<json-file>.json
# google sheet credential，改由雲端管理時
GOOGLE_SHEET_KEY=<JSON_KEY_CONTENT> # 直接上傳


# ─── Task06 & Task08 ──────────────────────────────────────────────────────
# 在地端與 GCS 互動，雲端部署不需要:
GOOGLE_APPLICATION_CREDENTIALS==<path>/<to>/<json-file>.json
# 在地端測試 google-genai-sdk 與 Google GenAI 互動需要的 key，雲端部署不需要:
AGENT_PLATFORM_USER_CREDENTIALS==<path>/<to>/<json-file>.json
# GCP PROJECT ID:
GCP_PROJECT_ID=<your-gcp-project-id>

# ─── Task07 ──────────────────────────────────────────────────────
# GCP PROJECT ID:
GCP_PROJECT_ID=<your-gcp-project-id>
# 在地端測試 google-genai-sdk 與 Google GenAI 互動需要的 key，雲端部署不需要:
AGENT_PLATFORM_USER_CREDENTIALS==<path>/<to>/<json-file>.json
# 在地端與 GCS 互動，雲端部署不需要:
GOOGLE_APPLICATION_CREDENTIALS==<path>/<to>/<json-file>.json

# OneNote API:
ONENOTE_CLIENT_ID=<Azure App Registration Client ID>
ONENOTE_OUTPUT_DIR=<path>/<to>/<storage>/<your-onenote>/

# 執行環境:
ENVIRONMENT=<env_name> # local | dev | prod

# OneNote 筆記 bucket
ONENOTE_GCS_BUCKET=<bucket-name-for-onenote-on-gcs>


# ─── Streamlit Frontend ──────────────────────────────────────────────────────
# Three roles granted to access page "onenote_review.py" and "ai_knowledge_agent.py":
ROLE_ML_USERNAME=<username1>
ROLE_ML_PASSWORD=<password1>
ROLE_OWNER_USERNAME=<username2>
ROLE_OWNER_PASSWORD=<password2>
ROLE_SENIOR_USERNAME=<username3>
ROLE_SENIOR_PASSWORD=<password3>
SILVER_ENDPOINT_URL=http://localhost:8002/enrich  # 部署後換成 cloud run service endpoint URL (記得加/enrich)
GOLD_ENDPOINT_URL=http://localhost:8003/archive  # 部署後換成 cloud run service endpoint URL (記得加/archive)

# Reranker API KEY used in "ai_knowledge_agent.py":
COHERE_API_KEY=<cohere_API_key>
