# Streamlit 內建 OIDC 登入設定範本（st.login / st.user）。
#
# 使用方式：
#   1. 複製成 .streamlit/secrets.toml（該檔已列入 .gitignore，不會進版控）
#   2. 把下面四個值填成真的內容，取得方式見註解
#
# 雲端部署不使用這個檔，Cloud Run 由 workflow 以 Secret Manager 注入同名設定。

[auth]
# 登入完成後 Google 導回的位址，路徑 /oauth2callback 由 Streamlit 固定，不可更改。
# 這個值必須與 GCP Credentials 頁面上該 OAuth Web client 的 Authorized redirect URIs 完全一致，
# 不一致會在登入時出現 redirect_uri_mismatch。
# 地端：http://localhost:8501/oauth2callback
# 雲端：https://<cloud-run-service-url>/oauth2callback
redirect_uri = "http://localhost:8501/oauth2callback"

# Streamlit 用來簽自己的登入 cookie，不是 Google 給的，由自己產生一串隨機字串：
#   poetry run python -c "import secrets; print(secrets.token_hex(32))"
# 換掉這個值會讓所有人被登出，且所有 Cloud Run 實例必須共用同一個值。
# 對應 Secret Manager 的 OIDC_COOKIE_SECRET。
cookie_secret = "<執行上面那行指令產生的隨機字串>"

[auth.google]
# GCP Console > APIs & Services > Credentials 建立的 OAuth 2.0 Client ID（Web application）。
# 對應 Secret Manager 的 OIDC_CLIENT_ID 與 OIDC_CLIENT_SECRET。
client_id = "<OAuth Web client 的 client id>"
client_secret = "<OAuth Web client 的 client secret>"

# Google 的 discovery 文件網址路徑，固定值。Streamlit 從這裡自動找出登入、換證與公鑰三個網址。
server_metadata_url = "https://accounts.google.com/.well-known/openid-configuration"
